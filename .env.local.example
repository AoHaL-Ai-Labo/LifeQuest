# データベース (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/lifequest"

# AI (Google Gemini)
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Auth.js シークレット（必須）
# 生成方法: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# Google OAuth
# 取得先: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Discord OAuth
# 取得先: https://discord.com/developers/applications
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# X (Twitter) OAuth
# 取得先: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"
